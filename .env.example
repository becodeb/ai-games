# Puerto interno del contenedor (Coolify lo mapea al dominio automaticamente)
PORT=3000
HOST=0.0.0.0

NODE_ENV=production

# Ruta del archivo SQLite. En Docker apunta al volumen persistente.
DATABASE_PATH=/data/steamlab.db

# Carpeta del build del cliente que sirve el servidor Express.
CLIENT_DIST=/app/client/dist
