# Puerto interno del contenedor (Coolify lo mapea al dominio automaticamente)
PORT=3000
HOST=0.0.0.0

NODE_ENV=production

# Ruta del archivo SQLite. En Docker apunta al volumen persistente.
DATABASE_PATH=/data/steamlab.db

# Carpeta del build del cliente que sirve el servidor Express.
CLIENT_DIST=/app/client/dist

# ---------------------------------------------------------------------------
# Generacion automatica de juegos con IA (opcional)
# Sin ANTHROPIC_API_KEY la funcion no existe y la app funciona como siempre
# (el profe copia el prompt y pega la respuesta).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo de Anthropic y esfuerzo de razonamiento (low | medium | high | xhigh | max).
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium
# true: al enviar el alumno se genera solo. false: solo con el boton "Generar con IA".
AI_AUTO=true
# Generaciones en paralelo y tope en las ultimas 24 horas (cuidan el gasto: la app no tiene login).
AI_MAX_CONCURRENCY=3
AI_DAILY_LIMIT=150
